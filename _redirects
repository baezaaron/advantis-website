# Netlify _redirects file - overrides netlify.toml configurations
# These rules ensure direct access to static files

# All static files are served directly without redirection
/*.css  /:splat  200
/*.js   /:splat  200
/*.jpg  /:splat  200
/*.jpeg /:splat  200
/*.png  /:splat  200
/*.svg  /:splat  200
/*.webp /:splat  200
/*.woff /:splat  200
/*.woff2 /:splat  200
/*.ttf  /:splat  200
/*.ico  /:splat  200
/*.json /:splat  200
/*.xml  /:splat  200
/*.txt  /:splat  200

# All HTML files are served directly
/*.html /:splat  200

# Default fallback to index.html for all other routes
/*     /index.html     200 