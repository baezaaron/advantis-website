<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Enhanced URL Rewrite rules for HTTPS redirection with loop prevention -->
        <rewrite>
            <rules>
                <rule name="HTTP to HTTPS redirect" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{HTTPS}" pattern="off" ignoreCase="true" />
                        <add input="{HTTP_HOST}" pattern="localhost" negate="true" />
                        <add input="{HTTP_HOST}" pattern="127\.0\.0\.1" negate="true" />
                        <add input="{REQUEST_URI}" pattern="^/fix-redirects\.html$" negate="true" />
                        <add input="{REQUEST_URI}" pattern="^/redirect-fix\.html$" negate="true" />
                        <add input="{HTTP_COOKIE}" pattern="redirect_loop_detected=1" negate="true" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
                </rule>
                
                <!-- HTML extension handling for clean URLs -->
                <rule name="HTML extension" stopProcessing="true">
                    <match url="^(.*)$" />
                    <conditions logicalGrouping="MatchAll" trackAllCaptures="false">
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
                    </conditions>
                    <action type="Rewrite" url="{R:1}.html" />
                </rule>
                
                <!-- Detect and set cookie for redirect loops -->
                <rule name="Detect Redirect Loops" stopProcessing="true">
                    <match url=".*" />
                    <conditions>
                        <add input="{HTTP_COOKIE}" pattern="redirect_loop_detected=1" />
                    </conditions>
                    <serverVariables>
                        <set name="HTTP_REDIRECT_LOOP_DETECTED" value="1" />
                    </serverVariables>
                    <action type="None" />
                </rule>
            </rules>
            <outboundRules>
                <!-- Set cookie if redirect loop detected -->
                <rule name="Set Loop Detection Cookie" preCondition="Is Loop Response">
                    <match serverVariable="RESPONSE_Set_Cookie" pattern=".*" />
                    <action type="Rewrite" value="redirect_loop_detected=1; path=/; max-age=3600; {R:0}" />
                </rule>
                <preConditions>
                    <preCondition name="Is Loop Response">
                        <add input="{HTTP_REDIRECT_LOOP_DETECTED}" pattern="1" />
                    </preCondition>
                </preConditions>
            </outboundRules>
        </rewrite>
        
        <!-- Enhanced cache control -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:00:00" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
        </staticContent>
        
        <!-- Add CORS and security headers -->
        <httpProtocol>
            <customHeaders>
                <clear />
                <add name="Access-Control-Allow-Origin" value="*" />
                <add name="Access-Control-Allow-Methods" value="GET, POST, OPTIONS" />
                <add name="Access-Control-Allow-Headers" value="Origin, X-Requested-With, Content-Type, Accept" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-UA-Compatible" value="IE=edge,chrome=1" />
                <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
                <add name="Pragma" value="no-cache" />
                <add name="Expires" value="0" />
            </customHeaders>
        </httpProtocol>
        
        <!-- Set default document priorities -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
                <add value="index.html" />
                <add value="redirect-fix.html" />
            </files>
        </defaultDocument>
        
        <!-- Custom errors -->
        <httpErrors errorMode="Custom">
            <remove statusCode="404" />
            <error statusCode="404" path="/redirect-fix.html" responseMode="ExecuteURL" />
        </httpErrors>
    </system.webServer>
</configuration> 